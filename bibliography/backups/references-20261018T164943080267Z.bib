@article{Tanabashi2018,
  abstract = {The Review summarizes much of particle physics and cosmology. Using data from previous editions, plus 2,873 new measurements from 758 papers, we list, evaluate, and average measured properties of gauge bosons and the recently discovered Higgs boson, leptons, quarks, mesons, and baryons. We summarize searches for hypothetical particles such as supersymmetric particles, heavy bosons, axions, dark photons, etc. Particle properties and search limits are listed in Summary Tables. We give numerous tables, figures, formulae, and reviews of topics such as Higgs Boson Physics, Supersymmetry, Grand Unified Theories, Neutrino Mixing, Dark Energy, Dark Matter, Cosmology, Particle Detectors, Colliders, Probability and Statistics. Among the 118 reviews are many that are new or heavily revised, including a new review on Neutrinos in Cosmology.Starting with this edition, the Review is divided into two volumes. Volume 1 includes the Summary Tables and all review articles. Volume 2 consists of the Particle Listings. Review articles that were previously part of the Listings are now included in volume 1.The complete Review (both volumes) is published online on the website of the Particle Data Group (http://pdg.lbl.gov) and in a journal. Volume 1 is available in print as the PDG Book. A Particle Physics Booklet with the Summary Tables and essential tables, figures, and equations from selected review articles is also available.The 2018 edition of the Review of Particle Physics should be cited as: M. Tanabashi (Particle Data Group), Phys. Rev. D 98, 030001 (2018).},
  author = {M. Tanabashi and K. Hagiwara and K. Hikasa and K. Nakamura and Y. Sumino and F. Takahashi and J. Tanaka and K. Agashe and G. Aielli and C. Amsler and M. Antonelli and D. M. Asner and H. Baer and Sw Banerjee and R. M. Barnett and T. Basaglia and C. W. Bauer and J. J. Beatty and V. I. Belousov and J. Beringer and S. Bethke and A. Bettini and H. Bichsel and O. Biebel and K. M. Black and E. Blucher and O. Buchmuller and V. Burkert and M. A. Bychkov and R. N. Cahn and M. Carena and A. Ceccucci and A. Cerri and D. Chakraborty and M. C. Chen and R. S. Chivukula and G. Cowan and O. Dahl and G. D’Ambrosio and T. Damour and D. de Florian and A. de Gouvêa and T. DeGrand and P. de Jong and G. Dissertori and B. A. Dobrescu and M. D’Onofrio and M. Doser and M. Drees and H. K. Dreiner and D. A. Dwyer and P. Eerola and S. Eidelman and J. Ellis and J. Erler and V. V. Ezhela and W. Fetscher and B. D. Fields and R. Firestone and B. Foster and A. Freitas and H. Gallagher and L. Garren and H. J. Gerber and G. Gerbier and T. Gershon and Y. Gershtein and T. Gherghetta and A. A. Godizov and M. Goodman and C. Grab and A. V. Gritsan and C. Grojean and D. E. Groom and M. Grünewald and A. Gurtu and T. Gutsche and H. E. Haber and C. Hanhart and S. Hashimoto and Y. Hayato and K. G. Hayes and A. Hebecker and S. Heinemeyer and B. Heltsley and J. J. Hernández-Rey and J. Hisano and A. Höcker and J. Holder and A. Holtkamp and T. Hyodo and K. D. Irwin and K. F. Johnson and M. Kado and M. Karliner and U. F. Katz and S. R. Klein and E. Klempt and R. V. Kowalewski and F. Krauss and M. Kreps and B. Krusche and Yu V. Kuyanov and Y. Kwon and O. Lahav and J. Laiho and J. Lesgourgues and A. Liddle and Z. Ligeti and C. J. Lin and C. Lippmann and T. M. Liss and L. Littenberg and K. S. Lugovsky and S. B. Lugovsky and A. Lusiani and Y. Makida and F. Maltoni and T. Mannel and A. V. Manohar and W. J. Marciano and A. D. Martin and A. Masoni and J. Matthews and U. G. Meißner and D. Milstead and R. E. Mitc