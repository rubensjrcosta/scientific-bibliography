  journal = {Journal of Computational Physics},
  keywords = {Arbitrary high order,Charged particle,Explicit method,Symplectic integrator,Time-dependent electromagnetic field, unclassified},
  pages = {245-251},
  title = {Explicit high-order symplectic integrators for charged particles in general electromagnetic fields},
