@article{Vay2007Noninvariance,
  abstract = {We present an analysis which shows that the ranges of space and time scales spanned by a system are not invariant under Lorentz transformation. This implies the existence of a frame of reference which minimizes an aggregate measure of the range of space and time scales. Such a frame is derived, for example, for the following cases: free electron laser, laser-plasma accelerator, and particle beams interacting with electron clouds. The implications for experimental, theoretical, and numerical studies are discussed. The most immediate relevance is the reduction by orders of magnitude in computer simulation run times for such systems. © 2007 The American Physical Society.},
  author = {J. L. Vay},
  doi = {10.1103/physrevlett.98.130405},
