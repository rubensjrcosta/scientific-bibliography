@article{WEEKES2002221,
    abstract = {The Very Energetic Radiation Imaging Telescope Array System (VERITAS) represents an important step forward in the study of extreme astrophysical processes in the universe. It combines the power of the atmospheric Cherenkov imaging technique using a large optical reflector with the power of stereoscopic observatories using arrays of separated telescopes looking at the same shower. The seven identical telescopes in VERITAS, each of aperture 10 m, will be deployed in a filled hexagonal pattern of side 80 m; each telescope will have a camera consisting of 499 pixels with a field of view of 3.5°. VERITAS will substantially increase the catalog of very high energy (E>100 GeV) γ-ray sources and greatly improve measurements of established sources.},
    author = {T.C Weekes and H Badran and S.D Biller and I Bond and S Bradbury and J Buckley and D Carter-Lewis and M Catanese and S Criswell and W Cui and P Dowkontt and C Duke and D.J Fegan and J Finley and L Fortson and J Gaidos and G.H Gillanders and J Grindlay and T.A Hall and K Harris and A.M Hillas and P Kaaret and M Kertzman and D Kieda and F Krennrich and M.J Lang and S LeBohec and R Lessard and J Lloyd-Evans and J Knapp and B McKernan and J McEnery and P Moriarty and D Muller and P Ogden and R Ong and D Petry and J Quinn and N.W Reay and P.T Reynolds and J Rose and M Salamon and G Sembroski and R Sidwell and P Slane and N Stanton and S.P Swordy and V.V Vassiliev and S.P Wakely},
    bib_categories = {active_galactic_nuclei, gamma_ray_astronomy, instrumentation, pulsars_pwn, supernova_remnants},
    doi = {https://doi.org/10.1016/S0927-6505(01)00152-9},
    issn = {0927-6505},
    journal = {Astroparticle Physics},
    keywords = {γ-ray astronomy, γ-ray telescopes, Atmospheric Cherenkov radiation, Pulsars, AGN, Supernova remnants, Galactic plane, Neutralinos},
    number = {2},
