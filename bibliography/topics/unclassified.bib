    issn = {1070664X},
    issue = {7},
    journal = {Physics of Plasmas},
    keywords = {Computer tomography,Doppler spectroscopy,Electrical propulsion,Ion thruster,Magnetic surfaces,Micro ion engine,Microwave plasma,microwave-excited plasma,three-dimensional fluid simulation, unclassified},
    pages = {2652-2658},
    pmid = {16606002},
    title = {TOPICAL REVIEW A review of recent laboratory double layer},
    url = {http://thesis.library.caltech.edu/1974/%5Cnhttp://link.aip.org/link/JAPIAU/v84/i7/p3541/s1&Agg=doi},
