@article{Matsumoto1998Mersenne,
    abstract = {A new algorithm called Mersenne Twister (MT) is proposed for generating uniform pseudorandom numbers. For a particular choice of parameters, the algorithm provides a super astronomical period of 219937 - 1 and 623-dimensional equidistribution up to 32-bit accuracy, while using a working area of only 624 words. This is a new variant of the previously proposed generators, TGFSR, modified so as to admit a Mersenne-prime period. The characteristic polynomial has many terms. The distribution up to v bits accuracy for 1 ≤ v ≤ 32 is also shown to be good. An algorithm is also given that checks the primitivity of the characteristic polynomial of MT with computational complexity O(p2) where p is the degree of the polynomial. We implemented this generator in portable C-code. It passed several stringent statistical tests, including diehard. Its speed is comparable to other modern generators. Its merits are due to the efficient algorithms that are unique to polynomial calculations over the two-element field.},
    author = {Makoto Matsumoto and Takuji Nishimura},
    doi = {10.1145/272991.272995},
    issn = {10493301},
    issue = {1},
    journal = {ACM Transactions on Modeling and Computer Simulation},
    keywords = {Finite fields,GFSR,Incomplete array,Inversive-decimation method,M-sequences,MT19937,Mersenne Primes,Mersenne Twister,Multiple-recursive matrix method,Primitive polynomials,Random number generation,TGFSR,Tempering,k-distribution, unclassified},
    pages = {3-30},
    title = {Mersenne Twister: A 623-Dimensionally Equidistributed Uniform Pseudo-Random Number Generator},
    volume = {8},
    year = {1998}
}

@article{Brandenburg2005Case,
    abstract = {Arguments for and against the widely accepted picture of a solar dynamo being seated in the tachocline are reviewed, and alternative ideas concerning dynamos operating in the bulk of the convection zone, or perhaps even in the near-surface shear layer, are discussed. Based on the angular velocities of magnetic tracers, it is argued that the observations are compatible with a distributed dynamo that may be strongly shaped by the near-surface shear layer. Direct simulations of dynamo action in a slab with turbulence and shear are presented to discuss filling factor and tilt angles of bipolar regions in such a model. ? 2005. The American Astronomical Society. All rights reserved.},
    author = {Axel Brandenburg},
    doi = {10.1086/429584},
    issn = {0004-637X},
    issue = {1},
    journal = {The Astrophysical Journal},
    keywords = {unclassified},
    pages = {539-547},
    title = {The Case for a Distributed Solar Dynamo Shaped by Near‐Surface Shear},
    volume = {625},
    year = {2005}
}

