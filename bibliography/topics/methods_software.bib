@article{Costa2024Gamma,
    abstract = {Recent studies by LHAASO have shown the presence of high-luminosity PeVatrons in our Galaxy. We examine two notable sources, each consisting of two pulsars, detected by LHAASO. We study gamma and cosmic-ray emissions from the surroundings of these pulsars. We used the Gammapy software to perform gamma-ray measurements from these sources in anticipation of future analyses to be carried out with the CTAO, which is now under development. Furthermore, the particle propagation throughout the Galaxy was simulated using the GALPROP software, accounting for emission from energy losses due to spin-down. As a result, we present the particle spectra generated during this propagation phase along with the corresponding gamma-ray emission. The findings suggest that CTAO may have the capability to detect these sources and show that the data can be explained by gamma rays coming from a leptonic model.},
    author = {Rubens Jr. Costa and Debora B. Götz and Rita C. Anjos and Luiz A. Stuani Pereira and Alexandre J.T.S. Mello},
    bib_categories = {cosmic_rays, gamma_ray_astronomy, instrumentation, methods_software, pulsars_pwn},
    doi = {10.1088/1475-7516/2024/07/035},
    issn = {1475-7516},
    issue = {07},
    journal = {Journal of Cosmology and Astroparticle Physics},
    keywords = {observatories},
    month = {7},
    pages = {035},
    title = {A gamma-ray study of galactic PeVatron candidates LHAASO J1825-1326 and LHAASO J1839-0545},
    url = {https://iopscience.iop.org/article/10.1088/1475-7516/2024/07/035},
    volume = {2024},
    year = {2024}
}

