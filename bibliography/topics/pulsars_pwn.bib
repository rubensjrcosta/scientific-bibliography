    abstract = {The Large High Altitude Air Shower Observatory (LHAASO) has recently published the first results, including the discovery of 12 ultrahigh-energy gamma-ray sources (with emission above 100TeV) above 7σ confidence level and a detailed analysis of Crab Nebula. This contribution gives a brief introduction to the LHAASO experiment and its recent discoveries.},
    author = {Ruo Yu Liu},
    bib_categories = {cosmic_rays, gamma_ray_astronomy, pulsars_pwn},
